# Copy to .env (untracked) and fill in this host's paths. The justfile loads it (`set dotenv-load`).
# No script carries a default: an UNSET variable makes its check SKIP loudly, naming the variable.

# just test -- a stock Athena CONCEPT.csv (tab-delimited)
VOCABULARY_FORMATS_ATHENA_CSV=
# just test -- a vocabulation build (.duckdb, schema ohdsi_vocabs); the only home of CPT4_HCPCS / ICD03_*
VOCABULARY_FORMATS_OI_DUCKDB=
# just prose -- the FY2026 ICD-10-CM tabular (.duckdb with tables notes, codes)
VOCABULARY_FORMATS_TABULAR_DUCKDB=
# just prose -- a directory of JATS .nxml articles (the litmine pilot papers)
VOCABULARY_FORMATS_PAPERS_DIR=
