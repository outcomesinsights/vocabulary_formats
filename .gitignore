
# Dolt database files (added by bd init)
.dolt/
*.db

# Diagnostic logs from `just lint` / `just test` — local artifacts, not repo history
claude_stuff/

# Per-host substrate/corpus paths for `just test` / `just prose` -- the names are in .env.example
.env

# Python bytecode from `just prose` importing the harness next door
__pycache__/

# Claude Code agent worktrees — local, per-agent; never committed
.claude/worktrees/

# Beads JSONL export -- not supported. The Dolt remote at refs/dolt/data is the store and the
# backup. Ignored so a stray export is never committed; delete one if it appears, because
# `bd bootstrap` would load from it if the Dolt remote failed.
.beads/issues.jsonl
